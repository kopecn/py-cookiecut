{% macro camelcase(value) -%}
  {%- set words = value.replace('-', ' ').replace('_', ' ').split() -%}
  {%- if words | length == 0 -%}
    ''
  {%- else -%}
    {{ words[0].lower() }}{{ words[1:] | map('capitalize') | join('') }}
  {%- endif -%}
{%- endmacro %}

{{ camelcase(cookiecutter.projectName) }}