# ==============================
# Python Build / Bytecode Artifacts
# ==============================

# Compiled Python files (bytecode)
__pycache__/
*.py[cod]
*$py.class

# Compiled binary extensions
*.c
*.so
*.pyd
*.dll

# Directory-level compiled artifacts
build/
dist/
develop-eggs/
sdist/
parts/
var/


# ==============================
# Virtual Environments & Dependencies
# ==============================

# General virtual environments (Modern and Classic)
.venv/
.cleanroom-venv/   # Throwaway clean-room venv for `make testInEnv` (VENV in .env)
venv/
env/
.env/

# Specific package manager caches / lock files
poetry.lock
Pipfile.lock
# uv.lock is intentionally NOT committed: this is a library, so we declare version
# ranges (requires-python) and stay on uv's `uv pip` interface, which never writes a
# lockfile (only `uv sync`/`uv lock` do). Ignored as belt-and-suspenders.
uv.lock
# requirements.txt is a GENERATED, local-only artifact (`make lock` compiles it from
# pyproject.toml). pyproject is the sole authored dep source (ranges) — never commit
# the compiled pin-set.
requirements.txt
# requirements-local.txt is the per-machine co-development overlay (`-e ../sibling`
# editable lines) consumed by `make editable-local`/`sync-local`. Never committed.
requirements-local.txt
*.egg-info/ # Generic wheel/package info folders

# PDK / Environment Specific Cache Folders
.tox/
.nox/
.mypy_cache/

# ==============================
# Tooling and Static Analysis Caches
# ==============================

# Coverage / Testing Reports
.coverage
.coverage.*
htmlcov/

# Pytest cache directory
.pytest_cache/ 

# Mypy specific files
dmypy.json

# Ruff (Linter) cache
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/


# ==============================
# IDEs, Editors, and OS System Files
# ==============================

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Standard VCS/Code Editor folders
.idea/          # IntelliJ IDEA family
*.iml           # Generic module file
.vscode/        # VS Code workspace settings

# Python boilerplate / Framework config
local_settings.py # Django specific local overrides


# ==============================
# Packaging, Installation & Build Systems
# ==============================

# General package distribution folders (PyInstaller/Build tools)
*.spec         # PyInstaller spec files
.Python        # Setuptools directory
MANIFEST       # Man pages/manifests

# CMake build system files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake


# ==============================
# Documentation and Translations
# ==============================

# Sphinx documentation builds
docs/_build/

# Translation files (gettext)
*.mo
*.pot


# ==============================
# Local Runtime Data & Logs 
# (DO NOT COMMIT THESE FILES!)
# ==============================

# Databases and local state files
db.sqlite3       # SQLite database file
instance/        # Flask application instance folder
storage/*        # General storage data folder (if applicable)

# Logs
*.log            # Generic log files
pip-log.txt
