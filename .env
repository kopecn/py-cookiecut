# Development environment settings used by the Makefile.

# Python interpreter used by pip-based targets.
PYTHON=python3

# Default Python version. This version must also be listed in PYTHONS.
DEFAULT_PYTHON=3.13

# Python versions tested by this template. Separate versions with spaces.
# Python 3.15 is temporarily excluded until PyYAML provides a compatible wheel.
PYTHONS=3.11 3.12 3.13 3.14
# PYTHONS=3.11 3.12 3.13 3.14 3.15

# Temporary virtual environment used by `make testInEnv`.
# It is separate from the `.venv` development environment and is removed after use.
VENV=.cleanroom-venv
